# Never put secrets here - VITE_ variables are bundled into the client.
VITE_PORT=5173
VITE_APP_NAME=Fayyaz Ali
VITE_APP_URL=http://localhost:5173
VITE_API_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=

# Siri AI endpoint. Empty = answers from local portfolio data.
VITE_SIRI_API_URL=/api/siri/chat

# Firebase (web app config). Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- Server-only (Vercel functions in /api). No VITE_ prefix: never bundled into the browser. ----
# Gmail SMTP with a Google App Password (Google Account > Security > App passwords)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# where "new chat message" alerts are sent (defaults to MAIL_FROM_ADDRESS)
CHAT_NOTIFY_TO=
# public site address used in email links (defaults to the request's origin)
SITE_URL=

# Local testing only: point the app at the Firebase emulators (npm run emulators)
VITE_FIREBASE_EMULATORS=false

# ---- Siri AI (server-only). The keyword Siri is the automatic backup. ----
# Google AI Studio > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Public site address for SEO (canonical URL, sitemap, social previews). Set to your live domain.
VITE_SITE_URL=
